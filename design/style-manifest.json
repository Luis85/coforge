          "--coforge-ds-typography-label-weight",
          "--coforge-ds-typography-label-line-height",
          "--coforge-ds-typography-label-tracking"
        ],
        "className": "coforge-ds-typography-label"
      },
      {
        "id": "page-title",
        "variables": [
          "--coforge-ds-typography-page-title-font",
