        "variables": [
          "--coforge-ds-spacing-md"
        ],
        "className": "coforge-ds-spacing-md"
      },
      {
        "id": "sm",
        "variables": [
          "--coforge-ds-spacing-sm"
        ],
        "className": "coforge-ds-spacing-sm"
      },
      {
        "id": "xl",
        "variables": [
          "--coforge-ds-spacing-xl"
        ],
        "className": "coforge-ds-spacing-xl"
      },
      {
        "id": "xs",
        "variables": [
          "--coforge-ds-spacing-xs"
        ],
        "className": "coforge-ds-spacing-xs"
      }
    ],
    "sizes": [
      {
        "id": "control",
        "variables": [
          "--coforge-ds-sizes-control"
        ],
        "className": "coforge-ds-sizes-control"
      },
      {
        "id": "icon",
        "variables": [
          "--coforge-ds-sizes-icon"
        ],
        "className": "coforge-ds-sizes-icon"
      },
      {
        "id": "inspector",
        "variables": [
          "--coforge-ds-sizes-inspector"
        ],
        "className": "coforge-ds-sizes-inspector"
      }
    ],
    "radii": [
      {
        "id": "control",
        "variables": [
          "--coforge-ds-radii-control"
        ],
        "className": "coforge-ds-radii-control"
      },
      {
        "id": "surface",
        "variables": [
          "--coforge-ds-radii-surface"
        ],
        "className": "coforge-ds-radii-surface"
      }
    ],
    "colors": [
      {
        "id": "accent",
        "variables": [
          "--coforge-ds-colors-accent"
        ],
        "className": "coforge-ds-colors-accent"
      },
      {
        "id": "accent-text",
        "variables": [
          "--coforge-ds-colors-accent-text"
        ],
        "className": "coforge-ds-colors-accent-text"
