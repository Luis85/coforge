      {
        "id": "background",
        "variables": [
          "--coforge-ds-colors-background"
        ],
        "className": "coforge-ds-colors-background"
      },
      {
        "id": "muted",
        "variables": [
          "--coforge-ds-colors-muted"
        ],
        "className": "coforge-ds-colors-muted"
