          "--coforge-ds-typography-page-title-tracking"
        ],
        "className": "coforge-ds-typography-page-title"
      },
      {
        "id": "section-title",
        "variables": [
          "--coforge-ds-typography-section-title-font",
          "--coforge-ds-typography-section-title-size",
          "--coforge-ds-typography-section-title-weight",
          "--coforge-ds-typography-section-title-line-height",
          "--coforge-ds-typography-section-title-tracking"
        ],
        "className": "coforge-ds-typography-section-title"
      }
    ],
    "spacing": [
      {
        "id": "lg",
        "variables": [
          "--coforge-ds-spacing-lg"
        ],
        "className": "coforge-ds-spacing-lg"
      },
      {
