{
  "name": "coforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#tui/*": "./src/tui/*"
  },
  "bin": {
    "obs-shell": "bin/app"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@iconify-json/lucide": "1.2.142",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-vue": "10.11.1",
    "fallow": "3.34.1",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "obsidian": "1.14.4",
    "oxlint": "1.89.0",
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nuxt/ui": "4.12.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "yaml": "2.9.1"
  },
  "description": "Build a game with your stream community and AI agents, from chat ideas and votes to screened, planned and reviewed increments.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.19.1 <13"
  },
  "scripts": {
    "setup": "node bin/app setup",
    "make": "node bin/app make",
    "entities:check": "node tooling/makers/entities.mjs --check",
    "entities:catalog": "node tooling/makers/entities.mjs",
    "dev:ui": "vite --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --open /harness/app/",
    "dev": "node tooling/dev/watch-local.mjs --no-local",
    "build": "node tooling/bundling/build.mjs",
    "build:local": "node tooling/dev/install-local.mjs --vault .",
    "test-build": "npm run build:local",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --project configs/types/tsconfig.project.json",
    "test": "vitest run --config configs/testing/vitest.project.config.mjs",
    "test:watch": "vitest --config configs/testing/vitest.project.config.mjs",
    "test:coverage": "vitest run --coverage --config configs/testing/vitest.config.mjs",
    "harness:build": "vite build --config configs/bundling/vite.harness.config.mjs",
    "harness:preview": "vite preview --config configs/bundling/vite.harness.config.mjs --host 127.0.0.1 --port 4180 --strictPort",
    "test:e2e": "playwright test",
    "ui:gallery": "node tooling/ui/review-gallery.mjs --target clickdummy",
    "check:tokens": "node tooling/styles/check-tokens.mjs",
    "check:style-literals": "node tooling/styles/check-style-literals.mjs",
    "check:source": "node tooling/quality/check-source.mjs",
    "check:presentation": "node tooling/quality/check-presentation.mjs",
    "check:self-review": "node tooling/quality/self-review.mjs",
    "check:artifacts": "node tooling/quality/check-artifacts.mjs",
    "lint": "node tooling/quality/lint-source.mjs && eslint -c configs/lint/eslint.config.mjs src templates/companion/runtime",
    "analyze": "fallow dead-code -c configs/quality/fallow.json",
    "verify": "node tooling/quality/verify.mjs",
    "help": "node bin/app help",
    "dev:local": "node tooling/dev/watch-local.mjs",
    "check:architecture": "node tooling/quality/check-architecture.mjs",
    "test:native": "node tooling/testing/check-native.mjs",
    "test:obsidian": "node tooling/testing/run-obsidian-tests.mjs",
    "dev:obsidian": "node tooling/dev/obsidian-dev.mjs",
    "check:analyzer": "node tooling/quality/check-analyzer.mjs",
    "check:maintainability": "node tooling/quality/check-maintainability.mjs",
    "check:security": "node tooling/security/audit.mjs",
    "check:dependencies": "node tooling/security/check-dependencies.mjs",
    "test:coverage:production": "vitest run --coverage --config configs/testing/vitest.production.config.mjs && node tooling/quality/coverage-inventory.mjs",
    "examples:remove": "node tooling/examples/cli.mjs",
    "check:projects": "node tooling/projects/projects.mjs check",
    "projects:sync": "node tooling/projects/projects.mjs sync",
    "check:docs-launchers": "node tooling/quality/check-docs-launchers.mjs",
    "events:catalog": "node tooling/events/catalog.mjs",
    "events:check": "node tooling/events/catalog.mjs --check",
    "app": "node bin/app",
    "new": "node bin/app new",
    "capabilities": "node tooling/operations/cli.mjs",
    "test:suites": "node tooling/testing/suites.mjs",
    "test:unit": "node tooling/testing/suites.mjs --level unit",
    "test:integration": "node tooling/testing/suites.mjs --level integration",
    "check": "node bin/app check",
    "check:fast": "node bin/app check --fast",
    "check:submission": "node bin/app check submission",
    "typecheck:sitemap": "node node_modules/typescript/bin/tsc --noEmit --project configs/types/tsconfig.sitemap.json",
    "maker": "node bin/app studio",
    "typecheck:maker": "node node_modules/typescript/bin/tsc -b src/cli",
    "test:plugins": "node tooling/testing/suites.mjs workbench-plugins",
    "check:plugins": "node tooling/quality/check-workbench-plugins.mjs",
    "build:cli": "node tooling/bundling/build-cli.mjs",
    "app:dev": "node src/cli/app.ts",
    "generate": "node bin/app generate",
    "status": "node bin/app status",
    "doctor": "node bin/app doctor",
    "test:framework": "vitest run --config configs/testing/vitest.config.mjs",
    "test:tdd": "vitest --config configs/testing/vitest.project.config.mjs \"src/plugin/tests/project/acceptance\"",
    "typecheck:project": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit --project configs/types/tsconfig.project.json",
    "test:ui-effects": "node -e \"console.log('test:ui-effects skipped: this project declares no visual definitions, so no UI-effect checks were generated.')\"",
    "build:clickdummy": "node bin/app clickdummy build",
    "dev:preview": "node bin/app dev --profile preview",
    "airship:status": "node bin/app airship status",
    "airship:enable": "node bin/app airship enable",
    "airship:disable": "node bin/app airship disable",
    "airship:install": "node bin/app airship install",
    "airship:start": "node bin/app airship start",
    "airship:doctor": "node bin/app airship doctor",
    "test:e2e:framework": "playwright test --config configs/testing/playwright.config.ts",
    "test:ui-quality": "playwright test tests/e2e/ui-quality.spec.ts",
    "test:project": "node tooling/testing/suites.mjs project && npm run test:ui-effects",
    "verify:artifacts": "npm run build && npm run test:ui-effects",
    "verify:project": "npm run check && npm run verify:artifacts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "fsevents": false
  },
  "overrides": {
    "fontless@0.2.1": {
      "esbuild": "0.28.2"
    },
    "obsidian@1.12.3": {
      "moment": "2.31.0"
    }
  },
  "packageManager": "npm@11.19.1",
  "author": "Luis Mendez"
}
